---
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const props = Astro.props;

// Site-wide medical clinic schema (LocalBusiness / MedicalClinic + Physician)
const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'MedicalClinic',
	'@id': `${SITE.url}/#clinic`,
	name: SITE.name,
	url: SITE.url,
	telephone: SITE.phone,
	email: SITE.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: SITE.address.street,
		addressLocality: SITE.address.city,
		addressRegion: SITE.address.region,
		postalCode: SITE.address.postal,
		addressCountry: SITE.address.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: SITE.geo.lat,
		longitude: SITE.geo.lng,
	},
	medicalSpecialty: 'Regenerative medicine',
	openingHours: SITE.hours.schema,
	sameAs: Object.values(SITE.social),
	physician: {
		'@type': 'Physician',
		name: SITE.doctor,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Site-wide head injector: edit /site-head.js on the server to add
		     analytics, Meta Pixel, verification tags, etc. (no rebuild needed) -->
		<script is:inline src="/site-head.js"></script>
		<link rel="icon" href="/favicon.jpg" type="image/jpeg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" preload />
		<Seo {...props} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify(orgSchema)}
		/>
	</head>
	<body>
		<a href="#main" class="sr-only">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			// "Book a consultation" buttons: if the page has a lead form (#request),
			// smooth-scroll to it and focus the first field; otherwise fall back to
			// the online booking URL (data-fallback). Header "Book a visit" is untouched.
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				const a = target.closest('a[data-scroll-form]') as HTMLAnchorElement | null;
				if (!a) return;
				const form = document.getElementById('request');
				if (form) {
					e.preventDefault();
					form.scrollIntoView({ behavior: 'smooth', block: 'start' });
					const field = form.querySelector('input:not([type=hidden]):not(.hp), textarea') as HTMLElement | null;
					if (field) window.setTimeout(() => field.focus({ preventScroll: true }), 600);
				} else if (a.dataset.fallback) {
					e.preventDefault();
					window.open(a.dataset.fallback, '_blank', 'noopener');
				}
			});
		</script>
	</body>
</html>
