---
import { NAV, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<span class="brand-mark" aria-hidden="true">USC</span>
			<p class="footer-name">{SITE.brandLine}</p>
			<p class="footer-tag">{SITE.tagline}</p>
		</div>

		<nav class="footer-col" aria-label="Footer">
			<h4>Explore</h4>
			<ul>
				{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
			</ul>
		</nav>

		<div class="footer-col">
			<h4>Visit us</h4>
			<address>
				{SITE.address.street}<br />
				{SITE.address.city}, {SITE.address.region} {SITE.address.postal}<br />
				<a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br />
				<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
			</address>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>© {year} {SITE.name}. All rights reserved.</p>
		<ul>
			<li><a href="/privacy-policy/">Privacy</a></li>
			<li><a href="/medical-disclaimer/">Medical disclaimer</a></li>
			<li><a href="/contact/">Contact</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--teal-900);
		color: var(--slate-200);
		padding-block: var(--space-16) var(--space-8);
		margin-top: var(--space-24);
	}
	.footer-grid {
		display: grid;
		gap: var(--space-8);
	}
	@media (min-width: 720px) {
		.footer-grid {
			grid-template-columns: 1.4fr 1fr 1fr;
		}
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 10px;
		background: var(--teal-600);
		color: #fff;
		font-family: var(--font-display);
		font-weight: 700;
		margin-bottom: var(--space-3);
	}
	.footer-name {
		font-family: var(--font-display);
		font-weight: 600;
		color: #fff;
		margin: 0 0 var(--space-1);
	}
	.footer-tag {
		color: var(--teal-200);
		font-size: var(--text-sm);
		max-width: 34ch;
	}
	.footer-col h4 {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--teal-200);
		margin: 0 0 var(--space-4);
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}
	.footer-col a,
	address a {
		color: var(--slate-200);
		text-decoration: none;
	}
	.footer-col a:hover,
	address a:hover {
		color: #fff;
		text-decoration: underline;
	}
	address {
		font-style: normal;
		line-height: 1.9;
		font-size: var(--text-sm);
	}
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		justify-content: space-between;
		align-items: center;
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: var(--text-sm);
		color: var(--teal-200);
	}
	.footer-bottom ul {
		display: flex;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
