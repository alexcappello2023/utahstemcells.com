---
import { NAV, SITE } from '../consts';
import logo from '../assets/logo.svg';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<img
				src={logo.src}
				width={logo.width}
				height={logo.height}
				alt="Utah Stem Cells"
				class="footer-logo"
			/>
			<p class="footer-tag">{SITE.tagline}</p>
			<ul class="footer-social">
				<li><a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
				<li><a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
				<li><a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer">YouTube</a></li>
			</ul>
		</div>

		<nav class="footer-col" aria-label="Footer">
			<h4>Explore</h4>
			<ul>
				{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
			</ul>
		</nav>

		<div class="footer-col">
			<h4>Visit us</h4>
			<address>
				{SITE.address.street}<br />
				{SITE.address.city}, {SITE.address.region} {SITE.address.postal}<br />
				<a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br />
				<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
			</address>
		</div>
	</div>

	<div class="container">
		<p class="footer-disclaimer">
			<strong>Important:</strong> All information presented on this website is intended
			for informational purposes only and not for the purpose of rendering medical
			advice. Statements made on this website have not been evaluated by the Food and
			Drug Administration. The information contained herein is not intended to
			diagnose, treat, cure or prevent any disease.
		</p>
	</div>

	<div class="container footer-bottom">
		<p>© {year} {SITE.name}. All rights reserved.</p>
		<ul>
			<li><a href="/out-of-town-patients/">Traveling patients</a></li>
			<li><a href="/privacy-policy/">Privacy</a></li>
			<li><a href="/medical-disclaimer/">Medical disclaimer</a></li>
			<li><a href="/contact/">Contact</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--brand-900);
		color: var(--slate-200);
		padding-block: var(--space-16) var(--space-8);
		margin-top: var(--space-24);
	}
	.footer-grid {
		display: grid;
		gap: var(--space-8);
	}
	@media (min-width: 720px) {
		.footer-grid {
			grid-template-columns: 1.4fr 1fr 1fr;
		}
	}
	.footer-logo {
		height: 66px;
		width: auto;
		margin-bottom: var(--space-4);
		filter: brightness(0) invert(1);
	}
	.footer-name {
		font-family: var(--font-display);
		font-weight: 600;
		color: #fff;
		margin: 0 0 var(--space-1);
	}
	.footer-tag {
		color: var(--brand-200);
		font-size: var(--text-sm);
		max-width: 34ch;
	}
	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		list-style: none;
		margin: var(--space-4) 0 0;
		padding: 0;
		font-size: var(--text-sm);
	}
	.footer-social a {
		color: var(--slate-200);
		text-decoration: none;
	}
	.footer-social a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.footer-col h4 {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--brand-200);
		margin: 0 0 var(--space-4);
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}
	.footer-col a,
	address a {
		color: var(--slate-200);
		text-decoration: none;
	}
	.footer-col a:hover,
	address a:hover {
		color: #fff;
		text-decoration: underline;
	}
	address {
		font-style: normal;
		line-height: 1.9;
		font-size: var(--text-sm);
	}
	.footer-disclaimer {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--brand-200);
	}
	.footer-disclaimer strong {
		color: #fff;
	}
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		justify-content: space-between;
		align-items: center;
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: var(--text-sm);
		color: var(--brand-200);
	}
	.footer-bottom ul {
		display: flex;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
