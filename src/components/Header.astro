---
import { NAV, SITE } from '../consts';
import logo from '../assets/logo.svg';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="brand" aria-label={`${SITE.name} home`}>
			<img
				src={logo.src}
				width={logo.width}
				height={logo.height}
				alt="Utah Stem Cells"
				class="brand-logo"
			/>
		</a>

		<input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
		<label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
			<span></span><span></span><span></span>
		</label>

		<nav class="site-nav" aria-label="Main">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								class={isActive(item.href) ? 'active' : ''}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a href={`tel:${SITE.phoneHref}`} class="btn btn-primary nav-cta">
				{SITE.phone}
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 72px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.brand-logo {
		height: 54px;
		width: auto;
		display: block;
	}
	@media (max-width: 860px) {
		.brand-logo {
			height: 44px;
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}
	.site-nav ul {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-nav a {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 0.98rem;
		color: var(--color-text);
		text-decoration: none;
	}
	.site-nav a:hover,
	.site-nav a.active {
		color: var(--color-primary);
	}
	.site-nav a.nav-cta {
		white-space: nowrap;
		background: #fff;
		color: var(--color-primary-dark);
		border-color: var(--color-primary);
	}
	.site-nav a.nav-cta:hover {
		background: var(--brand-50);
		color: var(--color-primary-dark);
	}

	.nav-toggle,
	.nav-burger {
		display: none;
	}
	.nav-burger {
		flex-direction: column;
		gap: 5px;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.nav-burger span {
		width: 24px;
		height: 2px;
		background: var(--color-text);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	@media (max-width: 860px) {
		.nav-burger {
			display: flex;
		}
		.site-nav {
			position: fixed;
			inset: 72px 0 auto 0;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-4);
			background: #fff;
			border-bottom: 1px solid var(--color-border);
			padding: var(--space-6);
			box-shadow: var(--shadow);
			transform: translateY(-120%);
			transition: transform 0.25s ease;
		}
		.site-nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-2);
		}
		.site-nav a {
			display: block;
			padding: var(--space-3) 0;
			font-size: 1.1rem;
			border-bottom: 1px solid var(--color-border);
		}
		.nav-cta {
			margin-top: var(--space-2);
		}
		.nav-toggle:checked ~ .site-nav {
			transform: translateY(0);
		}
	}
</style>
