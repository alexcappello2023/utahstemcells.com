---
import { getCollection } from 'astro:content';
import {
	NAV,
	SITE,
	TREATMENT_CATEGORIES,
	TREATMENT_LINKS,
	CONDITION_GROUPS,
	CONDITION_LINKS,
} from '../consts';
import logo from '../assets/logo.svg';

const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);

// Treatments grouped by category for the mega-menu
const treatments = await getCollection('treatments', ({ data }) => !data.draft);
treatments.sort((a, b) => a.data.order - b.data.order);
const treatmentGroups = Object.keys(TREATMENT_CATEGORIES)
	.map((key) => ({
		label: TREATMENT_CATEGORIES[key],
		items: treatments
			.filter((t) => t.data.category === key)
			.map((t) => ({
				href: `/treatments/${t.id}/`,
				label: TREATMENT_LINKS[t.id]?.label ?? t.data.title,
				title: TREATMENT_LINKS[t.id]?.title ?? t.data.summary,
			})),
	}))
	.filter((g) => g.items.length > 0);

// Conditions grouped for the mega-menu
const conditions = await getCollection('conditions', ({ data }) => !data.draft);
const condById = Object.fromEntries(conditions.map((c) => [c.id, c]));
const conditionGroups = CONDITION_GROUPS.map((g) => ({
	label: g.label,
	items: g.slugs
		.filter((s) => condById[s])
		.map((s) => ({
			href: `/conditions/${s}/`,
			label: CONDITION_LINKS[s]?.label ?? condById[s].data.title,
			title: CONDITION_LINKS[s]?.title ?? condById[s].data.summary,
		})),
})).filter((g) => g.items.length > 0);

const megaFor = (href: string) =>
	href === '/treatments/' ? treatmentGroups : href === '/conditions/' ? conditionGroups : null;
---

<div class="top-bar">
	<div class="container top-bar-inner">
		<div class="top-bar-left">
			<a href={`tel:${SITE.phoneHref}`} class="top-bar-item">
				<svg class="tb-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1z"/></svg>
				<span>{SITE.phone}</span>
			</a>
			<a href={`mailto:${SITE.email}`} class="top-bar-item">
				<svg class="tb-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2m0 2v.4l8 5 8-5V6H4m16 12V8.9l-8 5-8-5V18h16z"/></svg>
				<span>{SITE.email}</span>
			</a>
		</div>
		<div class="top-bar-social">
			<a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
				<svg class="tb-social" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07"/></svg>
			</a>
			<a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
				<svg class="tb-social" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.26 2.23.43.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.43 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.26 1.8-.43 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.43-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.8-.26-2.23-.43a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.43-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.06-1.17.26-1.8.43-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.43C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.12-1.38.66-.66 1.08-1.33 1.38-2.12.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.12A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0m0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.4-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88"/></svg>
			</a>
			<a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
				<svg class="tb-social" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12C24 15.93 24 12 24 12s0-3.93-.5-5.8M9.6 15.6V8.4l6.24 3.6z"/></svg>
			</a>
		</div>
	</div>
</div>

<header class="site-header">
	<div class="container header-inner">
		<div class="header-left">
			<a href="/" class="brand" aria-label={`${SITE.name} home`}>
				<img
					src={logo.src}
					width={logo.width}
					height={logo.height}
					alt="Utah Stem Cells"
					class="brand-logo"
				/>
			</a>
		</div>

		<input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
		<label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
			<span></span><span></span><span></span>
		</label>

		<nav class="site-nav" aria-label="Main">
			<ul>
				{
					NAV.map((item) => {
						const groups = megaFor(item.href);
						return groups ? (
							<li class="nav-mega">
								<a
									href={item.href}
									class={isActive(item.href) ? 'active' : ''}
									aria-haspopup="true"
								>
									{item.label}
									<span class="mega-caret" aria-hidden="true">▾</span>
								</a>
								<div class="mega-panel">
									<div class="container mega-inner">
										<div class="mega-grid">
											{groups.map((g) => (
												<div class="mega-col">
													<span class="mega-head">{g.label}</span>
													<ul>
														{g.items.map((it) => (
															<li>
																<a href={it.href} title={it.title}>
																	{it.label}
																</a>
															</li>
														))}
													</ul>
												</div>
											))}
										</div>
										<a href={item.href} class="mega-all">
											View all {item.label.toLowerCase()} →
										</a>
									</div>
								</div>
							</li>
						) : (
							<li>
								<a href={item.href} class={isActive(item.href) ? 'active' : ''}>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
			<a
				href={SITE.bookingUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary nav-cta"
			>
				Book a visit
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 72px;
	}
	.header-left {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.brand-logo {
		height: 54px;
		width: auto;
		display: block;
	}
	/* Top utility bar (#1779BC / white) */
	.top-bar {
		background: #1779bc;
		color: #fff;
	}
	.top-bar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-6);
		min-height: 38px;
		padding-block: 6px;
	}
	.top-bar-left {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-6);
	}
	.top-bar-social {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.top-bar-social a {
		display: inline-flex;
		color: #fff;
		opacity: 0.85;
		transition: opacity 0.15s ease;
	}
	.top-bar-social a:hover {
		opacity: 1;
	}
	.tb-social {
		width: 17px;
		height: 17px;
	}
	.top-bar-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #fff;
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 500;
	}
	.top-bar-item:hover {
		text-decoration: underline;
	}
	.tb-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
		opacity: 0.9;
	}
	@media (max-width: 560px) {
		.top-bar-inner {
			justify-content: center;
			gap: var(--space-2) var(--space-4);
		}
		.top-bar-item {
			font-size: 0.8rem;
		}
	}
	@media (max-width: 860px) {
		.brand-logo {
			height: 44px;
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}
	.site-nav > ul {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-nav a {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 0.98rem;
		color: var(--color-text);
		text-decoration: none;
	}
	.site-nav > ul > li > a:hover,
	.site-nav > ul > li > a.active {
		color: var(--color-primary);
	}
	.mega-caret {
		font-size: 0.7em;
		margin-left: 2px;
		color: var(--color-text-muted);
	}
	.site-nav a.nav-cta {
		white-space: nowrap;
		background: var(--color-primary);
		color: #fff;
		border-color: transparent;
	}
	.site-nav a.nav-cta:hover {
		background: var(--color-primary-dark);
		color: #fff;
	}

	/* --- Mega menu (desktop) --- */
	.mega-panel {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		background: #fff;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		box-shadow: var(--shadow);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
		z-index: 45;
	}
	.nav-mega:hover .mega-panel,
	.nav-mega:focus-within .mega-panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.mega-inner {
		padding-block: var(--space-8);
	}
	.mega-grid {
		column-count: 4;
		column-gap: var(--space-8);
	}
	.mega-col {
		break-inside: avoid;
		margin-bottom: var(--space-6);
	}
	.mega-head {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-primary);
		margin-bottom: var(--space-3);
	}
	.mega-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1px;
	}
	.mega-col a {
		display: block;
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.92rem;
		color: var(--color-text);
		padding: 5px 0;
	}
	.mega-col a:hover {
		color: var(--color-primary);
	}
	.mega-all {
		display: inline-block;
		margin-top: var(--space-6);
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-primary);
	}

	.nav-toggle,
	.nav-burger {
		display: none;
	}
	.nav-burger {
		flex-direction: column;
		gap: 5px;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.nav-burger span {
		width: 24px;
		height: 2px;
		background: var(--color-text);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	@media (max-width: 860px) {
		.nav-burger {
			display: flex;
		}
		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-4);
			background: #fff;
			border-bottom: 1px solid var(--color-border);
			padding: var(--space-6);
			box-shadow: var(--shadow);
			transform: translateY(-120%);
			transition: transform 0.25s ease;
		}
		.site-nav > ul {
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-2);
		}
		.site-nav > ul > li > a {
			display: block;
			padding: var(--space-3) 0;
			font-size: 1.1rem;
			border-bottom: 1px solid var(--color-border);
		}
		.mega-caret {
			display: none;
		}
		/* On mobile the mega panel collapses — Treatments links to the hub. */
		.mega-panel {
			display: none;
		}
		.nav-cta {
			margin-top: var(--space-2);
		}
		.nav-toggle:checked ~ .site-nav {
			transform: translateY(0);
		}
	}
</style>
