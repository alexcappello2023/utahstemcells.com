---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TREATMENT_CATEGORIES } from '../consts';

const categories = [
	{ key: 'regenerative', desc: 'Stem cell therapy, PRP, joint & hair restoration.' },
	{ key: 'sexual-health', desc: 'P-Shot, O-Shot, penile enhancement & wellness.' },
	{ key: 'hormones-wellness', desc: 'Bioidentical hormones (BHRT) & peptide therapy.' },
	{ key: 'iv-therapy', desc: 'NAD+, vitamin drips & recovery infusions.' },
	{ key: 'weight-loss', desc: 'Semaglutide (GLP-1) & medically supervised programs.' },
	{ key: 'aesthetics', desc: 'Lip filler, Votiva, Morpheus8 & vampire facials.' },
];

const conditions = [
	{ slug: 'knee-osteoarthritis', label: 'Knee osteoarthritis' },
	{ slug: 'rheumatoid-arthritis', label: 'Rheumatoid arthritis' },
	{ slug: 'autism', label: 'Autism' },
	{ slug: 'multiple-sclerosis', label: 'Multiple sclerosis' },
	{ slug: 'cerebral-palsy', label: 'Cerebral palsy' },
	{ slug: 'hair-loss', label: 'Hair loss' },
	{ slug: 'erectile-dysfunction', label: 'Erectile dysfunction' },
	{ slug: 'spinal-cord-injury', label: 'Spinal cord injury' },
];

const stats = [
	{ n: '15+', label: 'Years in regenerative medicine' },
	{ n: '10,000+', label: 'Treatments performed' },
	{ n: 'Sandy, UT', label: 'Serving the Salt Lake Valley' },
];
---

<BaseLayout
	title="Stem Cell Therapy in Utah | Utah Stem Cells & USC MedSpa"
	description="Utah Stem Cells offers advanced stem cell therapy, regenerative medicine and aesthetics in Sandy, UT. Led by Dr. William Cimikoski. Book your free consultation."
	canonicalPath="/"
>
	<!-- HERO -->
	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">Regenerative medicine · Sandy, Utah</p>
				<h1>Stem cell therapy that helps your body heal itself</h1>
				<p class="lead">
					Advanced regenerative medicine and aesthetics in the Salt Lake
					Valley, led by {SITE.doctor}. Non-surgical solutions for joints,
					hair, wellness and more.
				</p>
				<div class="hero-cta">
					<a href="/contact/" class="btn btn-primary">Book a free consultation</a>
					<a href="/treatments/" class="btn btn-ghost">Explore treatments</a>
				</div>
			</div>
			<div class="hero-panel" aria-hidden="true">
				<div class="hero-stats">
					{
						stats.map((s) => (
							<div>
								<span class="stat-n">{s.n}</span>
								<span class="stat-l">{s.label}</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- TREATMENT CATEGORIES -->
	<section class="section">
		<div class="container">
			<p class="eyebrow">What we treat</p>
			<h2>Treatments &amp; services</h2>
			<p class="lead" style="max-width:60ch">
				From stem cell therapy to medical aesthetics — explore our full range
				of regenerative and wellness care.
			</p>
			<div class="grid grid-3" style="margin-top:var(--space-8)">
				{
					categories.map((c) => (
						<a href="/treatments/" class="card cat-card">
							<h3>{TREATMENT_CATEGORIES[c.key]}</h3>
							<p>{c.desc}</p>
							<span class="card-link">See treatments →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- CONDITIONS -->
	<section class="section section-soft">
		<div class="container">
			<p class="eyebrow">Conditions we help with</p>
			<h2>Find care for your condition</h2>
			<p class="lead" style="max-width:60ch">
				Not sure which treatment is right for you? Start with your condition.
			</p>
			<div class="chip-grid">
				{
					conditions.map((c) => (
						<a href={`/conditions/${c.slug}/`} class="chip">
							{c.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- DOCTOR / E-E-A-T -->
	<section class="section">
		<div class="container doctor">
			<div class="doctor-photo" aria-hidden="true">Photo</div>
			<div>
				<p class="eyebrow">Meet your physician</p>
				<h2>Care led by {SITE.doctor}</h2>
				<p>
					Every treatment at Utah Stem Cells is overseen by a licensed
					physician with years of experience in regenerative medicine. We
					believe in honest, evidence-informed care — no hype, just what
					actually helps patients heal.
				</p>
				<a href="/about/dr-cimikoski/" class="btn btn-ghost"
					>Meet the doctor</a
				>
			</div>
		</div>
	</section>

	<!-- LOCATIONS -->
	<section class="section section-soft">
		<div class="container">
			<p class="eyebrow">Serving the Salt Lake Valley</p>
			<h2>Regenerative medicine near you</h2>
			<p class="lead" style="max-width:60ch">
				Based in Sandy, we welcome patients from across the Wasatch Front —
				Salt Lake City, South Jordan, Draper, Kaysville and beyond.
			</p>
			<a
				href="/locations/"
				class="btn btn-primary"
				style="margin-top:var(--space-4)">See all locations</a
			>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="cta-band">
		<div class="container cta-inner">
			<h2>Ready to take the first step?</h2>
			<p>Book a free, no-pressure consultation with our team.</p>
			<a href="/contact/" class="btn btn-accent">Book your consultation</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		background: linear-gradient(180deg, var(--brand-50), #fff);
		padding-block: clamp(var(--space-16), 9vw, var(--space-24));
	}
	.hero-inner {
		display: grid;
		gap: var(--space-12);
		align-items: center;
	}
	@media (min-width: 900px) {
		.hero-inner {
			grid-template-columns: 1.15fr 0.85fr;
		}
	}
	.hero-copy h1 {
		margin-top: var(--space-2);
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
	.hero-panel {
		background: var(--brand-600);
		border-radius: var(--radius-lg);
		padding: var(--space-8);
		box-shadow: var(--shadow-lg);
	}
	.hero-stats {
		display: grid;
		gap: var(--space-6);
	}
	.hero-stats > div {
		display: flex;
		flex-direction: column;
		padding-bottom: var(--space-4);
		border-bottom: 1px solid rgba(255, 255, 255, 0.18);
	}
	.hero-stats > div:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.stat-n {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-2xl);
		color: #fff;
	}
	.stat-l {
		color: var(--brand-100);
		font-size: var(--text-sm);
	}

	.cat-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--color-text);
	}
	.cat-card:hover {
		text-decoration: none;
	}
	.cat-card p {
		color: var(--color-text-muted);
		flex: 1;
	}
	.card-link {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-primary);
		font-size: var(--text-sm);
	}

	.chip-grid {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
	.chip {
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.6em 1.2em;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: var(--text-sm);
		color: var(--color-text);
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		text-decoration: none;
	}

	.doctor {
		display: grid;
		gap: var(--space-8);
		align-items: center;
	}
	@media (min-width: 760px) {
		.doctor {
			grid-template-columns: 300px 1fr;
		}
	}
	.doctor-photo {
		aspect-ratio: 4 / 5;
		background: var(--brand-100);
		border-radius: var(--radius-lg);
		display: grid;
		place-items: center;
		color: var(--brand-600);
		font-family: var(--font-display);
		font-weight: 600;
	}

	.cta-band {
		background: var(--brand-700);
		color: #fff;
		padding-block: var(--space-16);
	}
	.cta-inner {
		text-align: center;
	}
	.cta-inner h2 {
		color: #fff;
	}
	.cta-inner p {
		color: var(--brand-100);
		margin-bottom: var(--space-8);
	}
</style>
