---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TREATMENT_CATEGORIES } from '../consts';
import VisitClinic from '../components/VisitClinic.astro';
import drPhoto from '../assets/dr-cimikoski.jpeg';
import barbaraPhoto from '../assets/barbara-lorenzin.jpeg';
import heroFamily from '../assets/hero/hero-family.webp';
import heroRunning from '../assets/hero/hero-running.webp';
import heroSoccer from '../assets/hero/hero-soccer.webp';
import heroWoman from '../assets/hero/hero-woman.webp';

const heroSlides = [
	{ img: heroFamily, alt: 'Happy family outdoors in Utah' },
	{ img: heroRunning, alt: 'Young couple running on a Utah trail' },
	{ img: heroSoccer, alt: 'Competitive soccer athlete on the field' },
	{ img: heroWoman, alt: 'Radiant woman enjoying anti-aging care' },
];

const categories = [
	{ key: 'regenerative', desc: 'Stem cell joint regeneration, PRP & IV stem cell therapy.' },
	{ key: 'hair-restoration', desc: 'PRP & stem cell hair regrowth for men and women.' },
	{ key: 'sexual-wellness', desc: 'P-Shot, O-Shot, GAINSWave, Votiva & penile enhancement.' },
	{ key: 'hormones', desc: 'Hormone pellet therapy & lab work for men and women.' },
	{ key: 'aesthetics', desc: 'Botox, fillers, Sculptra, Morpheus8, microneedling & facials.' },
	{ key: 'body-contouring', desc: 'FaceTite, BodyTite, RF contouring, liposuction & fat transfer.' },
	{ key: 'weight-loss', desc: 'Physician-supervised weight loss & nutrition programs.' },
	{ key: 'iv-therapy', desc: 'IV vitamins, NAD+, high-dose vitamin C & wellness shots.' },
	{ key: 'ketamine', desc: 'Physician-supervised ketamine therapy sessions.' },
];

const conditions = [
	{ slug: 'knee-osteoarthritis', label: 'Knee osteoarthritis' },
	{ slug: 'rheumatoid-arthritis', label: 'Rheumatoid arthritis' },
	{ slug: 'autism', label: 'Autism' },
	{ slug: 'multiple-sclerosis', label: 'Multiple sclerosis' },
	{ slug: 'cerebral-palsy', label: 'Cerebral palsy' },
	{ slug: 'hair-loss', label: 'Hair loss' },
	{ slug: 'erectile-dysfunction', label: 'Erectile dysfunction' },
	{ slug: 'spinal-cord-injury', label: 'Spinal cord injury' },
];

const stats = [
	{ n: '15+', label: 'Years in regenerative medicine' },
	{ n: '10,000+', label: 'Treatments performed' },
	{ n: 'Sandy, UT', label: 'Serving the Salt Lake Valley' },
];
---

<BaseLayout
	title="Stem Cell Therapy in Utah | Utah Stem Cells & USC MedSpa"
	description="Utah Stem Cells offers advanced stem cell therapy, regenerative medicine and aesthetics in Sandy, UT. Led by Dr. William Cimikoski. Book your free consultation."
	canonicalPath="/"
>
	<!-- HERO -->
	<section class="hero">
		<div class="hero-slides" aria-hidden="true">
			{
				heroSlides.map((s, i) => (
					<Image
						class="hero-slide"
						src={s.img}
						alt={s.alt}
						width={1600}
						height={900}
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
				))
			}
		</div>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">Regenerative medicine · Sandy, Utah</p>
				<h1>Stem cell therapy that helps your body heal itself</h1>
				<p class="lead">
					Advanced regenerative medicine and aesthetics in the Salt Lake
					Valley, led by {SITE.doctor}. Non-surgical solutions for joints,
					hair, wellness and more.
				</p>
				<div class="hero-cta">
					<a
						href={SITE.bookingUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-accent">Book a free consultation</a
					>
					<a href="/treatments/" class="btn btn-ghost">Explore treatments</a>
				</div>
				<ul class="hero-stats">
					{
						stats.map((s) => (
							<li>
								<span class="stat-n">{s.n}</span>
								<span class="stat-l">{s.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- TREATMENT CATEGORIES -->
	<section class="section">
		<div class="container">
			<p class="eyebrow">What we treat</p>
			<h2>Treatments &amp; services</h2>
			<p class="lead" style="max-width:60ch">
				From stem cell therapy to medical aesthetics — explore our full range
				of regenerative and wellness care.
			</p>
			<div class="grid grid-3" style="margin-top:var(--space-8)">
				{
					categories.map((c) => (
						<a href="/treatments/" class="card cat-card">
							<h3>{TREATMENT_CATEGORIES[c.key]}</h3>
							<p>{c.desc}</p>
							<span class="card-link">See treatments →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- CONDITIONS -->
	<section class="section section-soft">
		<div class="container">
			<p class="eyebrow">Conditions we help with</p>
			<h2>Find care for your condition</h2>
			<p class="lead" style="max-width:60ch">
				Not sure which treatment is right for you? Start with your condition.
			</p>
			<div class="chip-grid">
				{
					conditions.map((c) => (
						<a href={`/conditions/${c.slug}/`} class="chip">
							{c.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- DOCTOR / E-E-A-T -->
	<section class="section">
		<div class="container doctor">
			<Image
				src={drPhoto}
				alt={`${SITE.doctor}, regenerative medicine physician`}
				width={600}
				height={750}
				class="doctor-photo"
			/>
			<div>
				<p class="eyebrow">Meet your physician</p>
				<h2>Care led by {SITE.doctor}</h2>
				<p>
					Every treatment at Utah Stem Cells is overseen by a licensed
					physician with years of experience in regenerative medicine. We
					believe in honest, evidence-informed care — no hype, just what
					actually helps patients heal.
				</p>
				<a href="/about/#dr-cimikoski" class="btn btn-ghost"
					>Meet the doctor</a
				>
			</div>
		</div>
	</section>

	<!-- INTERNATIONAL CONSULTANT / E-E-A-T -->
	<section class="section section-soft">
		<div class="container doctor reverse">
			<Image
				src={barbaraPhoto}
				alt="Dr. Barbara Lorenzin, international consultant"
				width={600}
				height={750}
				class="doctor-photo"
			/>
			<div>
				<p class="eyebrow">International consultant</p>
				<h2>Barbara Lorenzin, MD</h2>
				<p>
					An Italian physician with over 25 years in aesthetic and
					regenerative medicine, Dr. Lorenzin serves as International
					Consultant to Utah Stem Cells — bringing a European perspective
					that blends innovation, artistry and evidence-based care.
				</p>
				<a href="/about/#dr-lorenzin" class="btn btn-ghost">Read her full bio</a>
			</div>
		</div>
	</section>

	<!-- VISIT / LOCATIONS -->
	<VisitClinic />

	<!-- FINAL CTA -->
	<section class="cta-band">
		<div class="container cta-inner">
			<h2>Ready to take the first step?</h2>
			<p>Book a free, no-pressure consultation with our team.</p>
			<a
				href={SITE.bookingUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-accent">Book your consultation</a
			>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		align-items: center;
		/* Full-screen hero. dvh keeps it correct with mobile browser chrome. */
		min-height: 100vh;
		min-height: 100dvh;
		padding-block: var(--space-24);
		color: #fff;
	}
	.hero-slides {
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--brand-900);
	}
	.hero-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
		opacity: 0;
		animation: heroFade 28s infinite;
	}
	.hero-slide:nth-child(2) {
		animation-delay: 7s;
	}
	.hero-slide:nth-child(3) {
		animation-delay: 14s;
	}
	.hero-slide:nth-child(4) {
		animation-delay: 21s;
	}
	@keyframes heroFade {
		0% {
			opacity: 0;
		}
		4% {
			opacity: 1;
		}
		21% {
			opacity: 1;
		}
		25% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			95deg,
			rgba(8, 42, 66, 0.94) 0%,
			rgba(8, 42, 66, 0.82) 32%,
			rgba(8, 42, 66, 0.5) 62%,
			rgba(8, 42, 66, 0.2) 100%
		);
	}
	@media (max-width: 760px) {
		.hero::before {
			background: linear-gradient(
				175deg,
				rgba(8, 42, 66, 0.72) 0%,
				rgba(8, 42, 66, 0.88) 100%
			);
		}
	}
	.hero-copy {
		max-width: 640px;
	}
	.hero .eyebrow {
		color: var(--brand-200);
	}
	.hero h1 {
		color: #fff;
		margin-top: var(--space-2);
	}
	.hero .lead {
		color: rgba(255, 255, 255, 0.9);
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
	.hero :global(.btn-ghost) {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.55);
		background: transparent;
	}
	.hero :global(.btn-ghost:hover) {
		background: rgba(255, 255, 255, 0.14);
		border-color: #fff;
	}
	.hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8);
		list-style: none;
		margin: var(--space-12) 0 0;
		padding: var(--space-6) 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
	}
	.hero-stats li {
		display: flex;
		flex-direction: column;
	}
	.stat-n {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-xl);
		color: #fff;
	}
	.stat-l {
		color: rgba(255, 255, 255, 0.75);
		font-size: var(--text-sm);
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-slide {
			animation: none;
		}
		.hero-slide:first-child {
			opacity: 1;
		}
	}

	.cat-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--color-text);
	}
	.cat-card:hover {
		text-decoration: none;
	}
	.cat-card p {
		color: var(--color-text-muted);
		flex: 1;
	}
	.card-link {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-primary);
		font-size: var(--text-sm);
	}

	.chip-grid {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
	.chip {
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.6em 1.2em;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: var(--text-sm);
		color: var(--color-text);
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		text-decoration: none;
	}

	.doctor {
		display: grid;
		gap: var(--space-8);
		align-items: center;
	}
	@media (min-width: 760px) {
		.doctor {
			grid-template-columns: 300px 1fr;
		}
		.doctor.reverse {
			grid-template-columns: 1fr 300px;
		}
		.doctor.reverse .doctor-photo {
			order: 2;
		}
	}
	.doctor-photo {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}

	.cta-band {
		background: var(--brand-700);
		color: #fff;
		padding-block: var(--space-16);
	}
	.cta-inner {
		text-align: center;
	}
	.cta-inner h2 {
		color: #fff;
	}
	.cta-inner p {
		color: var(--brand-100);
		margin-bottom: var(--space-8);
	}
</style>
