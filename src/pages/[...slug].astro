---
import { getCollection } from 'astro:content';
import BlogArticle from '../components/BlogArticle.astro';
import TreatmentArticle from '../components/TreatmentArticle.astro';
import ConditionArticle from '../components/ConditionArticle.astro';
import LocationArticle from '../components/LocationArticle.astro';

// Root-level pages for treatments, conditions, locations and blog posts all
// live at /<slug>/ (no intermediate segment). Slugs are unique across the four
// collections (verified at build), so one dispatcher owns the root namespace.
export async function getStaticPaths() {
	const [blog, treatments, conditions, locations] = await Promise.all([
		getCollection('blog', ({ data }) => !data.draft),
		getCollection('treatments', ({ data }) => !data.draft),
		getCollection('conditions', ({ data }) => !data.draft),
		getCollection('locations', ({ data }) => !data.draft),
	]);
	return [
		...treatments.map((item) => ({ params: { slug: item.id }, props: { kind: 'treatment', item } })),
		...conditions.map((item) => ({ params: { slug: item.id }, props: { kind: 'condition', item } })),
		...locations.map((item) => ({ params: { slug: item.id }, props: { kind: 'location', item } })),
		...blog.map((item) => ({ params: { slug: item.id }, props: { kind: 'blog', item } })),
	];
}

const { kind, item } = Astro.props;
---

{
	kind === 'treatment' ? (
		<TreatmentArticle item={item} />
	) : kind === 'condition' ? (
		<ConditionArticle item={item} />
	) : kind === 'location' ? (
		<LocationArticle item={item} />
	) : (
		<BlogArticle item={item} />
	)
}
