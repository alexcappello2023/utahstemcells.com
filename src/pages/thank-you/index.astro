---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const socials = [
	{
		name: 'Facebook',
		href: SITE.social.facebook,
		path: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07',
	},
	{
		name: 'Instagram',
		href: SITE.social.instagram,
		path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.26 2.23.43.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.43 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.26 1.8-.43 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.43-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.8-.26-2.23-.43a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.43-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.06-1.17.26-1.8.43-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.43C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.12-1.38.66-.66 1.08-1.33 1.38-2.12.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.12A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0m0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.4-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88',
	},
	{
		name: 'YouTube',
		href: SITE.social.youtube,
		path: 'M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12C24 15.93 24 12 24 12s0-3.93-.5-5.8M9.6 15.6V8.4l6.24 3.6z',
	},
];
---

<BaseLayout
	title="Thank You | Utah Stem Cells"
	description="Thank you for contacting Utah Stem Cells. We'll be in touch shortly."
	canonicalPath="/thank-you/"
	noindex={true}
>
	<section class="section thank-you">
		<div class="container container-narrow ty-inner">
			<div class="ty-check" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="34" height="34"
					><path
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M20 6 9 17l-5-5"></path></svg
				>
			</div>
			<p class="eyebrow">Message sent</p>
			<h1>Thank you!</h1>
			<p class="lead">
				We've received your message and a member of our team will get back to you
				shortly.
			</p>

			<a href={`tel:${SITE.phoneHref}`} class="ty-call">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
					><path
						fill="currentColor"
						d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1z"
					></path></svg
				>
				<span>In a hurry? Call us at <strong>{SITE.phone}</strong></span>
			</a>

			<div class="ty-actions">
				<a href="/" class="btn btn-primary">Back to home</a>
				<a href="/treatments/" class="btn btn-ghost">Explore treatments</a>
			</div>

			<div class="ty-social">
				<h2>Let's stay in touch</h2>
				<p>
					Follow us on social — we regularly share news, tips and updates about our
					treatments, so you never miss what's new.
				</p>
				<div class="ty-social-links">
					{
						socials.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.name}
							>
								<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
									<path fill="currentColor" d={s.path} />
								</svg>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.thank-you {
		text-align: center;
		padding-block: var(--space-24);
	}
	.ty-inner {
		margin-inline: auto;
	}
	.ty-check {
		display: grid;
		place-items: center;
		width: 68px;
		height: 68px;
		margin: 0 auto var(--space-6);
		border-radius: 50%;
		background: var(--brand-50);
		color: var(--color-primary);
	}
	.ty-call {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
		padding: 0.7em 1.2em;
		border-radius: 999px;
		background: var(--brand-50);
		color: var(--color-primary-dark);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: background 0.15s ease;
	}
	.ty-call:hover {
		background: var(--brand-100);
	}
	.ty-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
	.ty-social {
		margin-top: var(--space-24);
		padding-top: var(--space-12);
		border-top: 1px solid var(--color-border);
	}
	.ty-social h2 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-3);
	}
	.ty-social p {
		color: var(--color-text-muted);
		max-width: 46ch;
		margin: 0 auto var(--space-6);
	}
	.ty-social-links {
		display: flex;
		justify-content: center;
		gap: var(--space-6);
	}
	.ty-social-links a {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--color-primary);
		color: #fff;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.ty-social-links a:hover {
		background: var(--color-primary-dark);
		transform: translateY(-2px);
	}
</style>
