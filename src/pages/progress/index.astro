---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

// Report mensili — il più recente in cima.
const months = (await getCollection('progress')).sort(
	(a, b) => b.data.month.valueOf() - a.data.month.valueOf()
);

const fmt = new Intl.DateTimeFormat('en-US', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

// "Ultimo aggiornamento" = la data più recente fra i report.
const updatedAt = months
	.map((m) => m.data.updated ?? m.data.month)
	.sort((a, b) => b.valueOf() - a.valueOf())[0];

const lists = [
	{ key: 'completed', label: 'Completed', tone: 'done' },
	{ key: 'ongoing', label: 'In progress', tone: 'doing' },
	{ key: 'next', label: 'Planned next', tone: 'next' },
] as const;
---

<BaseLayout
	title="Progress of work | Utah Stem Cells"
	description="A month-by-month record of the work being done on the Utah Stem Cells website."
	canonicalPath="/progress/"
	noindex={true}
>
	<section class="pw-hero">
		<div class="container container-narrow">
			<p class="eyebrow">Client area</p>
			<h1>Progress of work</h1>
			<p class="lead">
				A month-by-month record of everything being done on {SITE.name}'s website
				and marketing — what is finished, what is underway, and what comes next.
				This page is updated as the work moves forward.
			</p>
			{
				updatedAt && (
					<p class="pw-updated">
						Last updated <time datetime={updatedAt.toISOString()}>{fmt.format(updatedAt)}</time>
					</p>
				)
			}
		</div>
	</section>

	<section class="section">
		<div class="container container-narrow">
			{
				months.length === 0 && (
					<p class="pw-empty">The first monthly report will appear here shortly.</p>
				)
			}

			{
				months.map((m, i) => (
					<details class="pw-month" open={i === 0}>
						<summary>
							<span class="pw-month-head">
								<span class="pw-month-label">{m.data.label}</span>
								<span class={`pw-badge pw-badge-${m.data.status}`}>
									{m.data.status === 'in-progress' ? 'In progress' : 'Completed'}
								</span>
							</span>
							<span class="pw-chev" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="2.2"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="m6 9 6 6 6-6"
									/>
								</svg>
							</span>
						</summary>

						<div class="pw-body">
							<p class="pw-summary">{m.data.summary}</p>

							{m.data.stats.length > 0 && (
								<ul class="pw-stats">
									{m.data.stats.map((s) => (
										<li>
											<span class="pw-stat-value">{s.value}</span>
											<span class="pw-stat-label">{s.label}</span>
										</li>
									))}
								</ul>
							)}

							{lists.map(
								(list) =>
									m.data[list.key].length > 0 && (
										<div class="pw-block">
											<h2 class={`pw-block-title pw-${list.tone}`}>{list.label}</h2>
											<ul class="pw-items">
												{m.data[list.key].map((item) => (
													<li>
														<span class={`pw-dot pw-${list.tone}`} aria-hidden="true" />
														<div>
															<strong>{item.title}</strong>
															{item.detail && <p>{item.detail}</p>}
														</div>
													</li>
												))}
											</ul>
										</div>
									)
							)}
						</div>
					</details>
				))
			}

			<p class="pw-foot">
				Questions about anything on this page? Reply to your usual contact — or
				call the clinic at <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.pw-hero {
		background: linear-gradient(180deg, var(--brand-50), #fff);
		padding-block: var(--space-16) var(--space-8);
		border-bottom: 1px solid var(--color-border);
	}
	.pw-updated {
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.pw-empty {
		color: var(--color-text-muted);
	}

	/* --- month card --- */
	.pw-month {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: #fff;
		box-shadow: var(--shadow-sm);
		margin-bottom: var(--space-6);
	}
	.pw-month[open] {
		box-shadow: var(--shadow);
		border-color: var(--brand-200);
	}
	.pw-month > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-6);
		cursor: pointer;
		list-style: none;
	}
	.pw-month > summary::-webkit-details-marker {
		display: none;
	}
	.pw-month > summary:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-radius: var(--radius);
	}
	.pw-month-head {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.pw-month-label {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--color-text);
	}
	.pw-badge {
		font-size: var(--text-sm);
		line-height: 1;
		padding: 0.4em 0.8em;
		border-radius: 999px;
		white-space: nowrap;
	}
	.pw-badge-in-progress {
		background: var(--brand-50);
		color: var(--color-primary-dark);
	}
	.pw-badge-completed {
		background: var(--slate-100);
		color: var(--slate-700);
	}
	.pw-chev {
		flex: none;
		display: grid;
		place-items: center;
		color: var(--color-text-muted);
		transition: transform 0.2s ease;
	}
	.pw-month[open] .pw-chev {
		transform: rotate(180deg);
	}

	/* --- month body --- */
	.pw-body {
		padding: 0 var(--space-6) var(--space-6);
	}
	.pw-summary {
		margin: 0 0 var(--space-6);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
	}
	.pw-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: var(--space-3);
		list-style: none;
		margin: 0 0 var(--space-8);
		padding: 0;
	}
	.pw-stats li {
		background: var(--color-bg-soft);
		border-radius: var(--radius-sm);
		padding: var(--space-4);
		text-align: center;
	}
	.pw-stat-value {
		display: block;
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--color-primary);
		line-height: 1.2;
	}
	.pw-stat-label {
		display: block;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-top: var(--space-1);
	}

	.pw-block + .pw-block {
		margin-top: var(--space-8);
	}
	.pw-block-title {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 var(--space-4);
	}
	.pw-block-title.pw-done {
		color: #1f8a55;
	}
	.pw-block-title.pw-doing {
		color: var(--color-primary);
	}
	.pw-block-title.pw-next {
		color: var(--color-text-muted);
	}

	.pw-items {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid var(--color-border);
	}
	.pw-items li {
		position: relative;
		display: flex;
		gap: var(--space-3);
		padding: 0 0 var(--space-6) var(--space-6);
	}
	.pw-items li:last-child {
		padding-bottom: 0;
	}
	.pw-dot {
		position: absolute;
		left: -6px;
		top: 0.55em;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-border);
		box-shadow: 0 0 0 4px #fff;
	}
	.pw-dot.pw-done {
		background: #1f8a55;
	}
	.pw-dot.pw-doing {
		background: var(--color-primary);
	}
	.pw-items strong {
		display: block;
		color: var(--color-text);
	}
	.pw-items p {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
	}

	.pw-foot {
		margin-top: var(--space-12);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	@media (max-width: 560px) {
		.pw-month > summary,
		.pw-body {
			padding-inline: var(--space-4);
		}
	}
</style>
