---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../consts';
import reviewsData from '../../data/reviews.json';

const { rating, total, reviews, placeUrl } = reviewsData;
const hasReviews = reviews.length > 0;

const stars = (n: number) => '★★★★★☆☆☆☆☆'.slice(5 - Math.round(n), 10 - Math.round(n));

// Rich-snippet schema (AggregateRating + Review) — enables stars in Google results
const schema = hasReviews
	? {
			'@context': 'https://schema.org',
			'@type': 'MedicalClinic',
			name: SITE.name,
			url: SITE.url,
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: rating,
				reviewCount: total,
				bestRating: 5,
			},
			review: reviews.slice(0, 5).map((r) => ({
				'@type': 'Review',
				author: { '@type': 'Person', name: r.author },
				reviewRating: {
					'@type': 'Rating',
					ratingValue: r.rating,
					bestRating: 5,
				},
				reviewBody: r.text,
			})),
		}
	: null;
---

<BaseLayout
	title="Patient Reviews & Testimonials | Utah Stem Cells"
	description="Read real Google reviews from patients of Utah Stem Cells in Sandy, UT — regenerative medicine, aesthetics and wellness care led by Dr. William Cimikoski."
	canonicalPath="/reviews/"
>
	<header class="page-hero">
		<div class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]} />
			<p class="eyebrow">What patients say</p>
			<h1>Patient reviews &amp; testimonials</h1>
			{
				hasReviews ? (
					<div class="rating-summary">
						<span class="rating-stars" aria-hidden="true">{stars(rating)}</span>
						<span class="rating-value">{rating.toFixed(1)}</span>
						<span class="rating-meta">
							out of 5 · {total} Google reviews
						</span>
					</div>
				) : (
					<p class="lead">
						We're grateful for the trust our patients place in us.
					</p>
				)
			}
		</div>
	</header>

	<section class="section">
		<div class="container">
			{
				hasReviews ? (
					<div class="grid grid-3">
						{reviews.map((r) => (
							<figure class="card review-card">
								<div class="review-stars" aria-label={`${r.rating} out of 5`}>
									{stars(r.rating)}
								</div>
								<blockquote>{r.text}</blockquote>
								<figcaption>
									<span class="review-name">{r.author}</span>
									{r.when && <span class="review-when">{r.when}</span>}
								</figcaption>
							</figure>
						))}
					</div>
				) : (
					<p class="reviews-empty">
						Our patient reviews are loading soon. In the meantime, see them on
						our <a href={placeUrl || 'https://www.google.com/maps/search/Utah+Stem+Cells+Sandy+UT'} target="_blank" rel="noopener noreferrer">Google listing</a>.
					</p>
				)
			}
			{
				hasReviews && (
					<p class="reviews-source">
						Verified Google reviews.
						{placeUrl && (
							<>
								{' '}
								<a href={placeUrl} target="_blank" rel="noopener noreferrer">
									See all on Google
								</a>
							</>
						)}
					</p>
				)
			}
		</div>
	</section>

	<CtaBand
		title="Ready to become our next success story?"
		text="Book a free, no-pressure consultation with our team."
	/>
	{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</BaseLayout>

<style>
	.rating-summary {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		margin-top: var(--space-2);
		flex-wrap: wrap;
	}
	.rating-stars {
		color: var(--amber-500, #e8a33d);
		font-size: 1.6rem;
		letter-spacing: 2px;
		color: #f5a623;
	}
	.rating-value {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-2xl);
	}
	.rating-meta {
		color: var(--color-text-muted);
	}
	.review-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.review-stars {
		color: #f5a623;
		letter-spacing: 2px;
	}
	.review-card blockquote {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--color-text);
		flex: 1;
	}
	.review-card figcaption {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-3);
	}
	.review-name {
		font-family: var(--font-display);
		font-weight: 600;
	}
	.review-when {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.reviews-source {
		margin-top: var(--space-8);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.reviews-empty {
		text-align: center;
		color: var(--color-text-muted);
	}
</style>
