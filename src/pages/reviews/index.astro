---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
---

<BaseLayout
	title="Patient Reviews & Testimonials | Utah Stem Cells"
	description="Read real Google reviews from patients of Utah Stem Cells in Sandy, UT — regenerative medicine, aesthetics and wellness care led by Dr. William Cimikoski."
	canonicalPath="/reviews/"
>
	<header class="page-hero">
		<div class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]} />
			<p class="eyebrow">What patients say</p>
			<h1>Patient reviews &amp; testimonials</h1>
			<p class="lead">
				We're grateful for the trust our patients place in us. These are our real
				Google reviews.
			</p>
		</div>
	</header>

	<section class="section">
		<div class="container">
			<!-- Featurable Google reviews widget -->
			<div
				id="featurable-2b7e8daa-f199-46d6-9714-1cd846d023fc"
				data-featurable-async
				class="featurable-widget"
			>
			</div>
		</div>
	</section>

	<CtaBand
		title="Ready to become our next success story?"
		text="Book a free, no-pressure consultation with our team."
	/>
</BaseLayout>

<script is:inline src="https://featurable.com/assets/bundle.js" defer charset="UTF-8"></script>

<style>
	.featurable-widget {
		min-height: 400px;
	}
</style>
