# Copia questo file in ".env" per test in locale. NON committare ".env".
# In produzione questi valori vanno nei GitHub Secrets del repo.

# Anthropic (generazione articolo via Claude Code) — solo per la GitHub Action
ANTHROPIC_API_KEY=

# Pexels (immagine hero automatica)
PEXELS_API_KEY=

# FTP dell'hosting cPanel (deploy del sito)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=true
# Cartella remota di destinazione (di solito la document root del dominio)
FTP_REMOTE_DIR=/public_html

# (Opzionale) Google Sheet pubblicato come CSV con i topic, al posto del CSV locale
# GSHEET_CSV_URL=
